[Unit]
Description=BaseOS launcher
Wants=sway.service
After=sway.service rocknix-autostart.service

[Service]
Type=simple
Environment=HOME=/storage
Environment=XDG_RUNTIME_DIR=/var/run/0-runtime-dir
Environment=PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1
EnvironmentFile=/etc/profile
ExecStart=/usr/bin/baseos-launch
WorkingDirectory=/storage
Restart=always
RestartSec=2

[Install]
WantedBy=rocknix.target
