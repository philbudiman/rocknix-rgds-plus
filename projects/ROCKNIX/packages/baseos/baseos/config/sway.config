# SPDX-License-Identifier: GPL-2.0
# RG DS Plus: both panels stay on, one DS window per panel.
seat * hide_cursor 1000
default_border none
output DSI-1 mode 1024x768 position 0 0 bg #202020 solid_color
output DSI-2 mode 1024x768 position 1024 0 bg #202020 solid_color
workspace 1 output DSI-1
workspace 2 output DSI-2
input "1046:911:Goodix_Capacitive_TouchScreen" {
    map_to_output DSI-2
    # Output mapping supplies the desktop offset; undo the stock udev half-width map.
    calibration_matrix 1 0 0 0 1 0
}
for_window [title="^DSperate$"] move container to workspace 1, fullscreen enable
for_window [title="^DSperate \(Bottom\)$"] move container to workspace 2, fullscreen enable
workspace 1
